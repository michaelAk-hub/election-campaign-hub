  "name": "NotFoundVoter",
  "type": "object",
  "properties": {
    "submitted_id": {
      "type": "string",
      "description": "The ID that was submitted"
    },
    "reason_text": {
      "type": "string",
      "description": "Greek reason: '\u0389\u03b4\u03b7 \u03ae\u03c4\u03b1\u03bd \u03a8\u03ae\u03c6\u03b9\u03c3\u03b5 = \u039d\u0391\u0399' or '\u0394\u03b5\u03bd \u03b2\u03c1\u03ad\u03b8\u03b7\u03ba\u03b5 \u03b5\u03b3\u03b3\u03c1\u03b1\u03c6\u03ae \u03bc\u03b5 \u03b1\u03c5\u03c4\u03cc \u03c4\u03bf ID'"
    },
    "kanali_username": {
      "type": "string",
      "description": "Who submitted"
    }
  },
  "required": [
