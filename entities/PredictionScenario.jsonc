{
  "name": "PredictionScenario",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Scenario name"
    },
    "total_seats": {
      "type": "number",
      "description": "Total seats to allocate"
    },
    "display_order": {
      "type": "number",
      "default": 1,
      "description": "Display order (1-4)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "config_json": {
      "type": "object",
      "description": "Full scenario config: parties (name, color, symbols with multipliers), year_groups (name, conditions)"
    }
  },
  "required": [
    "name",
    "total_seats"
  ]
}