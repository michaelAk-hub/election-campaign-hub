    },
    "department": {
      "type": "string",
      "description": "TMHMA - Department"
    },
    "admission_year": {
      "type": "string",
      "description": "EISDOXI - Admission year"
    },
    "academic_level": {
      "type": "string",
      "description": "\u0395\u03a0\u0399\u03a0\u0395\u0394\u039f - Academic level"
    },
