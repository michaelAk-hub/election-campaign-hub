      "type": "string",
      "description": "\u0391\u03a4 (ID) - Unique person identifier"
    },
    "ucid": {
      "type": "string",
      "description": "UCID"
    },
    "mobile_phone": {
      "type": "string",
      "description": "\u039a\u0399\u039d\u0397\u03a4\u039f - Mobile phone"
    },
    "first_name": {
      "type": "string",
      "description": "\u039f\u039d\u039f\u039c\u0391 - First name"
